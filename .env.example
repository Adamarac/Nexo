# Copie para .env e troque todos os valores. O arquivo .env nunca vai para o repositório.
POSTGRES_ADMIN_PASSWORD=troque-esta-senha
NEXO_DB_PASSWORD=troque-esta-senha
RABBITMQ_PASSWORD=troque-esta-senha
NEXO_ADMIN_API_KEY=troque-esta-chave

# Opcional: carregar só a partir de um mês (formato AAAA-MM). Vazio carrega tudo que a CVM oferece.
CVM_EARLIEST_MONTH=

# Quantos workers processam arquivos em paralelo. Cada um usa cerca de 200 MB de memória.
WORKER_REPLICAS=3
