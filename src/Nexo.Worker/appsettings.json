{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=nexo;Username=nexo;Password=nexo",
    "Redis": "localhost:6379"
  },
  "RabbitMq": {
    "Uri": "amqp://nexo:nexo@localhost:5672"
  },
  "Storage": {
    "Root": "data/files"
  },
  "Watcher": {
    "Enabled": true,
    "RunOnStartup": true,
    "RunAt": [ "13:00", "19:00" ],
    "TimeZone": "America/Sao_Paulo"
  },
  "Worker": {
    "EnableProcessing": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System.Net.Http": "Warning",
        "Polly": "Warning"
      }
    }
  }
}
